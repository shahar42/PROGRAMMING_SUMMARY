    "typedef int (*CompareFunc)(const void *, const void *);",
    "void sort_with_callback(int *array, size_t size, CompareFunc cmp) {",
    "    // Implementation of a sort that uses the callback for comparison",
    "    for (size_t i = 0; i < size - 1; ++i) {",
    "        for (size_t j = i + 1; j < size; ++j) {",
    "            if (cmp(&array[i], &array[j]) > 0) {",
    "                int temp = array[i];",
    "                array[i] = array[j];",
    "                array[j] = temp;",
    "            }",
    "        }",
    "    }",
    "}",
    "int compare_desc(const void *a, const void *b) {",
    "    int arg1 = *(const int *)a;",
    "    int arg2 = *(const int *)b;",
    "    return (arg2 - arg1);",
    "}",
    "int main() {",
    "    int data[] = {3, 1, 4, 1, 5};",
    "    size_t size = sizeof(data) / sizeof(data[0]);",
    "    sort_with_callback(data, size, compare_desc);",
    "    // data is now sorted in descending order",
    "    return 0;",
    "}"
