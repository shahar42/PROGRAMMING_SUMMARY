  "code_example": [
    "#include <iostream>",
    "#include <vector>",
    "",
    "class Buffer {",
    "public:",
    "    int* data;",
    "    size_t size;",
    "    // Constructor",
    "    Buffer(size_t s) : data(new int[s]), size(s) {",
    "        std::cout << \"Constructed\" << std::endl;",
    "    }",
    "    // Destructor",
    "    ~Buffer() {",
    "        delete[] data;",
    "        std::cout << \"Destroyed\" << std::endl;",
    "    }",
    "    // Move constructor",
    "    Buffer(Buffer&& other) noexcept : data(other.data), size(other.size) {",
    "        other.data = nullptr;",
    "        other.size = 0;",
    "        std::cout << \"Moved\" << std::endl;",
    "    }",
    "    // Move assignment operator",
    "    Buffer& operator=(Buffer&& other) noexcept {",
    "        if (this != &other) {",
    "            delete[] data;",
    "            data = other.data;",
    "            size = other.size;",
    "            other.data = nullptr;",
    "            other.size = 0;",
    "            std::cout << \"Move assigned\" << std::endl;",
    "        }",
    "        return *this;",
    "    }",
    "    // Disable copy semantics for clarity",
    "    Buffer(const Buffer&) = delete;",
    "    Buffer& operator=(const Buffer&) = delete;",
    "};",
    "",
    "int main() {",
    "    std::vector<Buffer> buffers;",
    "    buffers.push_back(Buffer(10)); // Move constructor invoked",
    "    Buffer b1(20);",
    "    Buffer b2(30);",
    "    b2 = std::move(b1); // Move assignment invoked",
    "    return 0;",
    "}"
  ],
