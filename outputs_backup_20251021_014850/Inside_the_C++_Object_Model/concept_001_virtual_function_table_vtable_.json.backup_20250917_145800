    "public:",
    "    virtual void foo() { /* base implementation */ }",
    "};",
    "class Derived : public Base {",
    "public:",
    "    void foo() override { /* derived implementation */ }",
    "};",
    "int main() {",
    "    Base* p = new Derived();",
    "    p->foo(); // Virtual call: resolved via vtable at runtime",
    "}"
