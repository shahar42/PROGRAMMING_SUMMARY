#include <iostream>

// Task 1: Fixed Version - Proper Template Declaration

template <typename T>  // CORRECT: Template declaration added
T maxValue(T a, T b) {
    return (a > b) ? a : b;
}

int main() {
    std::cout << maxValue(5, 3) << std::endl;
    std::cout << maxValue(4.2, 3.7) << std::endl;
    
    return 0;
}