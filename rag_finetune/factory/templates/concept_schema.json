{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Programming Concept Schema",
  "description": "Schema for extracted programming concepts from technical books",
  "type": "object",
  "required": ["id", "topic", "book", "explanation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_]+_[a-z]+_[a-z0-9_]+_[a-f0-9]{6}$",
      "description": "Unique concept ID: {book_prefix}_{category}_{topic_slug}_{hash}"
    },
    "topic": {
      "type": "string",
      "minLength": 5,
      "maxLength": 150,
      "description": "Clear, concise topic title"
    },
    "book": {
      "type": "string",
      "description": "Full book title matching the source"
    },
    "category": {
      "type": "string",
      "enum": [
        "mem", "ptr", "func", "ctrl", "io", "data", "op",
        "obj", "class", "template", "inheritance", "poly",
        "sys", "proc", "thread", "sync", "file", "net",
        "algo", "struct", "perf", "debug", "build", "core"
      ],
      "description": "Concept category abbreviation"
    },
    "explanation": {
      "type": "string",
      "minLength": 100,
      "description": "Detailed explanation of the concept"
    },
    "code_example": {
      "type": "string",
      "description": "Minimal code snippet demonstrating the concept"
    },
    "practical_example": {
      "type": "string",
      "description": "Real-world usage example or scenario"
    },
    "related_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of related concept IDs"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable keywords for the concept"
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"],
      "description": "Difficulty level"
    },
    "page_reference": {
      "type": "string",
      "description": "Page number or range in source book"
    },
    "chapter": {
      "type": "string",
      "description": "Chapter title or number"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Concept IDs that should be understood first"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional categorization tags"
    }
  }
}
