    "    int* dynamicArray = (int*)malloc(5 * sizeof(int));  // Dynamic allocation",
    "    if (dynamicArray == NULL) {",
    "        printf(\"Allocation failed\\n\");",
    "        return 1;",
    "    }",
    "    for(int i = 0; i < 5; i++) {",
    "        dynamicArray[i] = staticArray[i] * 2;  // Combining both approaches",
