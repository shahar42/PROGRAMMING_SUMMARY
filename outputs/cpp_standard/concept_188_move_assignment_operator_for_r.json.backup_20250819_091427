    "#include <fstream>",
    "class MyFileStream {",
    "public:",
    "    std::ofstream ofs;",
    "    // Move assignment operator",
    "    MyFileStream& operator=(MyFileStream&& rhs) noexcept {",
    "        if (this != &rhs) {",
    "            ofs = std::move(rhs.ofs);",
    "        }",
    "        return *this;",
    "    }",
    "};",
