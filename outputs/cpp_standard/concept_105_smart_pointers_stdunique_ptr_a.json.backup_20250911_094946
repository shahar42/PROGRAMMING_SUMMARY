    "#include <iostream>",
    "#include <memory>",
    "",
    "class Resource {",
    "public:",
    "    Resource() { std::cout << \"Resource acquired\" << std::endl; }",
    "    ~Resource() { std::cout << \"Resource destroyed\" << std::endl; }",
    "    void do_something() { std::cout << \"Doing something\" << std::endl; }",
    "};",
    "",
    "int main() {",
    "    {",
    "        auto ptr1 = std::make_unique<Resource>(); // unique_ptr manages Resource",
    "        ptr1->do_something();",
    "    } // Resource is automatically destroyed here when ptr1 goes out of scope",
    "",
    "    {",
    "        auto ptr2 = std::make_shared<Resource>(); // shared_ptr manages Resource",
    "        auto ptr3 = ptr2; // shared ownership",
    "        ptr2->do_something();",
    "        std::cout << \"Shared pointers count: \" << ptr2.use_count() << std::endl;",
    "    } // Resource destroyed when last shared_ptr (ptr3) goes out of scope",
    "    return 0;",
    "}"
