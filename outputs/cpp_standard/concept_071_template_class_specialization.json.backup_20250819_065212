  "topic": "Template Class Specialization",
  "explanation": "Template class specialization in C++ allows developers to define custom implementations for specific template parameter types, enabling optimized or tailored behavior while maintaining generic code. This feature is essential for writing flexible, type-safe, and efficient code in modern C++, especially when certain types require unique handling that differs from the general template implementation.",
  "syntax": "template <typename T> class ClassName { /* general implementation */ };\n\n// Full specialization for a specific type\ntemplate <> class ClassName<SpecificType> { /* specialized implementation */ };\n\n// Partial specialization for a subset of types\ntemplate <typename T> class ClassName<SomeType<T>> { /* specialized implementation */ };\n",
  "code_example": [
    "#include <iostream>",
    "",
    "template <typename T>",
    "class Printer {",
    "public:",
    "    void print() const {",
    "        std::cout << \"Generic printer\" << std::endl;",
    "    }",
    "};",
    "",
    "// Full specialization for int",
    "template <>",
    "class Printer<int> {",
    "public:",
    "    void print() const {",
    "        std::cout << \"Integer printer\" << std::endl;",
    "    }",
    "};",
    "",
    "int main() {",
    "    Printer<double> pd;",
    "    pd.print(); // Calls generic template",
    "    Printer<int> pi;",
    "    pi.print(); // Calls specialized template for int",
    "    return 0;",
    "}"
  ],
