    "  int age;",
    "  Person(const std::string& n, int a) : name(n), age(a) {}",
    "};",
    "",
    "int main() {",
    "    std::vector<int> numbers;",
    "    numbers.push_back(10);",
    "    numbers.push_back(20);",
    "    numbers.emplace_back(30); //In-place construction",
    "",
    "    std::vector<Person> people;",
    "    people.push_back(Person(\"Alice\", 30)); // Copy construction",
    "    people.emplace_back(\"Bob\", 25); //In-place construction, avoids copy",
    "",
    "    for (const auto& num : numbers) {",
    "        std::cout << num << \" \";",
    "    }",
    "    std::cout << std::endl;",
    "",
    "    for (const auto& p : people) {",
    "        std::cout << p.name << \" (\" << p.age << \") \";",
    "    }",
    "    std::cout << std::endl;",
