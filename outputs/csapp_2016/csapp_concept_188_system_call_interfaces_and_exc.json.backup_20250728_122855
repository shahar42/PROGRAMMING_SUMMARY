    "int main() {",
    "  int pid = fork();",
    "  if (pid == 0) {",
    "    // Child process",
    "    execlp(\"date\", \"date\", NULL);",
    "    perror(\"execlp failed\");",
    "    exit(1);",
    "  } else if (pid > 0) {",
    "    // Parent process",
    "    printf(\"Parent process continuing...\\n\");",
    "    wait(NULL);",
    "    printf(\"Child process finished.\\n\");",
    "  }",
    "  else {",
    "    perror(\"fork failed\");",
    "    exit(1);",
    "  }",
    "  return 0;",
    "}"
