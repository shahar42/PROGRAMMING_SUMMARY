    "void register_callback(callback_t cb);",
    "void event_handler(int event_code) {",
    "    printf(\"Handling event %d\\n\", event_code);",
    "}",
    "int main() {",
    "    callback_t cb = event_handler;",
    "    register_callback(cb);",
