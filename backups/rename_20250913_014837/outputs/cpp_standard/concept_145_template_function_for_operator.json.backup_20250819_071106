    "template <typename Key, typename T, typename Compare, typename Allocator>",
    "bool operator!=(const std::multimap<Key, T, Compare, Allocator>& x, const std::multimap<Key, T, Compare, Allocator>& y) {",
    "    return !(x == y);",
    "}",
    "",
    "int main() {",
    "    std::multimap<int, std::string> map1 = {{1, \"one\"}, {2, \"two\"}};",
    "    std::multimap<int, std::string> map2 = {{1, \"one\"}, {2, \"two\"}};",
    "    ",
    "    if (map1 != map2) {",
    "        std::cout << \"Maps are different.\" << std::endl;",
    "    } else {",
    "        std::cout << \"Maps are equal.\" << std::endl;",
    "    }",
    "    return 0;",
    "}"
