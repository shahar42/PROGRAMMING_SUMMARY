    "    std::shared_ptr<Widget> sharedWidget2 = sharedWidget1; // shared ownership",
    "    sharedWidget1->do_something();",
    "    sharedWidget2->do_something();",
    "    // Widgets are automatically destroyed when last shared_ptr goes out of scope",
    "    return 0;",
    "}"
